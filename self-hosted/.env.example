# SentinelVault Self-Hosted Environment Configuration Template
# Copy this file to .env before running: `cp .env.example .env`

# ── Cryptographic Security Secrets (MANDATORY) ──────────────────────────────
# Secret key used for signing & validating HS256 JWT tokens.
# IMPORTANT: Must be at least 32 random characters in production!
# Generate using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_character_jwt_secret_key!

# ── Database Credentials & Connection ──────────────────────────────────────
POSTGRES_DB=sentinelvault
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=replace_with_a_strong_database_password_123!
POSTGRES_PORT=5432

# Connection DSN passed to NestJS TypeORM microservices
DATABASE_URL=postgres://sentinel_admin:replace_with_a_strong_database_password_123!@postgres:5432/sentinelvault

# ── Redis Cache & Revocation Store ─────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Service Port Binding Reference ─────────────────────────────────────────
PORT_AUTH=3001
PORT_SYNC=3002
PORT_SECURITY=3003
PORT_SHARING=3004

# ── Optional AI Insights Integration ────────────────────────────────────────
# Google Gemini API key used for generating AI security summaries.
# OPTIONAL: If left empty, security-analysis-service falls back gracefully
# to structured local summary generation with zero functionality loss.
GEMINI_API_KEY=
